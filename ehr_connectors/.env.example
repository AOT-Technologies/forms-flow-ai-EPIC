# Epic FHIR Configuration
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
EPIC_CLIENT_ID=your_client_id

# JWKS Authentication (Run generate_keys.py)
EPIC_KID=your_key_id
EPIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Interactive (patient-facing EHR-launch) SMART app config.
# This is a SEPARATE Epic app registration from EPIC_CLIENT_ID above - that
# one is "Backend Systems" (private_key_jwt, no user, used only for
# ehr_connectors' own writebacks) and can't do an interactive login at all.
# Register a second app with Audience=Patients, Launch Type=Patient
# Standalone/EHR Launch, and Incoming APIs including openid + fhirUser -
# EPIC_INTERACTIVE_CLIENT_ID is that second app's client_id, not a shared one.
EPIC_INTERACTIVE_CLIENT_ID=your_patient_facing_client_id
# Comma-separated allowlist of trusted Epic `iss` origins (prevents a caller
# from pointing `iss` at an attacker-controlled server during token exchange).
# While testing against launch.smarthealthit.org instead of real Epic, add
# its FHIR base here too (e.g. https://launch.smarthealthit.org/v/r4/fhir) -
# but don't ship a non-Epic iss in a production allowlist.
EPIC_ALLOWED_ISS=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# Launch-assertion signing key (Run generate_launch_assertion_key.py)
# Separate from EPIC_KID/EPIC_PRIVATE_KEY above - this pair signs the internal
# JWT handed to Keycloak, not anything sent to Epic.
LAUNCH_ASSERTION_KID=your_launch_assertion_key_id
LAUNCH_ASSERTION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Connector Configuration
PORT=8002
HOST=0.0.0.0
LOG_LEVEL=info
